{{define "title"}}{{.Section.Title}} · {{.World.Title}}{{end}}
{{define "bodyclass"}}page page__{{.Section.Slug}}{{end}}

{{define "content"}}
<div class="container">

    <!-- SUBSECCIONES -->
    <section class="subsections">
        {{range .Section.SubSections}}
        <article class="subsection card">
            <h3 class="subsection__title">{{.Title}}</h3>
            <ul class="subsection__links">
                <li><a href="#">Ver herramientas</a></li>
                <li><a href="#">Ver artículos e investigaciones</a></li>
                <li><a href="#">Ver anuncios</a></li>
            </ul>
        </article>
        {{end}}
    </section>

    <!-- REFLEXIÓN GUIADA -->
    <section class="question-generator">
        <h2 class="question-generator__title">Reflexión Guiada</h2>
        <div class="question-generator__list">
            {{range .Questions}}
            <article class="question-generator__item card">
                <p class="question-generator__question">{{.}}</p>
            </article>
            {{end}}
            <div class="question-generator__more">
                <button type="button" class="question-generator__more-link" aria-label="Generar pregunta">
                    <img src="/assets/icons/cargarmas.svg" alt="Generar pregunta" class="question-generator__more-icon">
                </button>
            </div>
        </div>
    </section>

    <!-- MIS PUBLICACIONES -->
    <section class="post-list">
        <h2 class="post-list__title">Mis Publicaciones</h2>
        <ul id="my-posts" class="post-list__items"
            data-world="{{.World.Slug}}"
            data-section="{{.Section.Slug}}"></ul>
    </section>

    <!-- PUBLICACIONES DE OTROS USUARIOS -->
    <section class="post-list">
        <h2 class="post-list__title">Publicaciones de otros usuarios</h2>
        <ul id="other-posts" class="post-list__items"></ul>
    </section>

</div>

<!-- PLANTILLA DE CARD (invisible hasta que JS la clona) -->
<template id="post-tpl">
    <li class="post-list__item">
        <article class="post card">
            <header class="post__header">
                <p class="post__user"></p>
            </header>
            <div class="post__content">
                <p class="post__text"></p>
                <img class="post__media" alt="Archivo adjunto" hidden>
            </div>
            <footer class="post__footer">
                <p class="post__location" hidden></p>
                <p class="post__date"></p>
                <div class="post__actions" hidden>
                    <button class="btn btn--edit" type="button">Editar</button>
                    <button class="btn btn--delete" type="button">Borrar</button>
                </div>
            </footer>
        </article>
    </li>
</template>

<select id="sections-data" hidden>
    <option value="">Sección</option>
    {{range .World.Sections}}
    <option value="{{.Slug}}">{{.Title}}</option>
    {{end}}
</select>

<div id="post-error" class="post-error" hidden></div>

<script src="/js/posts.js" defer></script>
{{end}}
